# Template. Copy to .env and fill in. Never put real values in this file.

# --- Databricks ---
DATABRICKS_HOST=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
# databricks-oauth = browser login, so no access token is stored anywhere
DATABRICKS_AUTH_TYPE=databricks-oauth

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=your-org-your-account
SNOWFLAKE_USER=YOUR_USER
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
