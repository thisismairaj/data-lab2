{
  "datasets": [
    {
      "name": "ds_state",
      "displayName": "Diabetes prevalence by state",
      "queryLines": [
        "SELECT survey_year, state_fips, state_name, valid_respondents, diabetes_yes, weighted_yes_sum, weighted_valid_sum, prevalence_weighted_pct / 100.0 AS prevalence_ratio\n",
        "FROM gold.diabetes_prevalence_state\n",
        "ORDER BY survey_year DESC, prevalence_ratio DESC"
      ],
      "columns": [
        {
          "displayName": "National Prevalence",
          "description": "Survey-weighted share of respondents with diabetes",
          "expression": "SUM(`weighted_yes_sum`) / SUM(`weighted_valid_sum`)"
        },
        {
          "displayName": "Valid Respondents",
          "description": "Respondents with a valid diabetes answer",
          "expression": "SUM(`valid_respondents`)"
        }
      ]
    },
    {
      "name": "ds_quarantine",
      "displayName": "Quarantined rows by rule",
      "queryLines": [
        "SELECT rule_id, survey_year, count(*) AS quarantined_rows FROM silver.quarantine GROUP BY rule_id, survey_year\n"
      ],
      "columns": [
        {
          "displayName": "Quarantined Rows",
          "description": "Rows held back by the quality rules, each with a reason",
          "expression": "SUM(`quarantined_rows`)"
        }
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Overview",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "header",
            "multilineTextboxSpec": {
              "lines": [
                "# Diabetes prevalence in the US (CDC BRFSS)\n",
                "\n",
                "Survey-weighted share of adults reporting diabetes, by state and year. Every row that fails a quality rule is held in quarantine with a reason, never dropped."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi-prevalence",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_state",
                  "fields": [
                    {
                      "name": "measure(National Prevalence)",
                      "expression": "MEASURE(`National Prevalence`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(National Prevalence)",
                  "displayName": "National prevalence",
                  "format": {
                    "type": "number-percent",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 2
                    }
                  }
                }
              },
              "frame": {
                "title": "National prevalence",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 3,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi-respondents",
            "queries": [
              {
                "name": "main_query",
                "query": {
