model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-PK
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["gold_diabetes_prevalence_state", "diabetes_prevalence_age_group", "diabetes_prevalence_smoking", "diabetes_prevalence_bmi_category", "diabetes_comorbidity", "diabetes_risk_stacking"]

annotation PBI_ProTooling = ["DevMode"]

ref table gold_diabetes_prevalence_state
ref table diabetes_prevalence_age_group
ref table diabetes_prevalence_smoking
ref table diabetes_prevalence_bmi_category
ref table diabetes_comorbidity
ref table diabetes_risk_stacking

ref cultureInfo en-US
